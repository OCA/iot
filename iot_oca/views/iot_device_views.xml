<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="iot_device_list" model="ir.ui.view">
        <field name="name">iot.device.list</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="name" />
                <field name="communication_system_id" />
                <field name="model" />
                <field name="last_contact_date" />
                <field name="group_id" />
                <field name="ip" />
            </list>
        </field>
    </record>
    <record id="iot_device_form" model="ir.ui.view">
        <field name="name">iot.device.form</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <field name="active" invisible="1" />
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        text="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field
                        name="image_1920"
                        widget='image'
                        class="oe_avatar"
                        options='{"preview_image": "image_128"}'
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="group_id" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            />
                            <field name="icon" />
                            <field
                                name="communication_system_id"
                                readonly="action_count"
                                widget="selection"
                            />
                            <field name="action_count" invisible="1" />
                        </group>
                        <group>
                            <field name="model" />
                            <field name="ip" />
                            <field name="state" />
                            <field name="last_contact_date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Actions" id="actions">
                            <field name="action_ids" readonly="True" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="iot_device_action_list" model="ir.ui.view">
        <field name="name">iot.device.action.list</field>
        <field name="model">iot.device.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="status" />
                <field name="result" />
                <field name="date_ok" />
                <button
                    name="run"
                    type="object"
                    string="Run"
                    invisible="status == 'ok'"
                />
            </list>
        </field>
    </record>
    <record id="iot_device_kanban" model="ir.ui.view">
        <field name="name">iot.device.kanban</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" class="o_kanban_small_column" sample="1">
                <field name="name" />
                <field name="state" />
                <field name="communication_system_id" />
                <field name="group_id" />
                <field name="color" />
                <field name="id" />
                <field name="image_128" />
                <field name="icon" />
                <field name="tag_ids" />
                <field name="last_contact_date" />
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable">
                            <a
                                role="menuitem"
                                type="edit"
                                class="dropdown-item"
                            >Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a
                                role="menuitem"
                                type="delete"
                                class="dropdown-item"
                            >Delete</a>
                        </t>
                        <field name="color" widget="kanban_color_picker" />
                    </t>
                    <t t-name="card">
                        <div
                            class="o_kanban_record_top d-flex justify-content-between align-items-center mb-2"
                        >
                            <div class="o_kanban_record_headings overflow-hidden">
                                <strong
                                    class="o_kanban_record_title fs-5 text-truncate d-block mb-0"
                                >
                                    <field name="name" />
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body flex-grow-1">
                            <div
                                t-if="record.group_id.raw_value"
                                class="text-muted small mb-1"
                            >
                                <i class="fa fa-folder-open-o me-1" title="Group" />
                                <field name="group_id" />
                            </div>
                            <div
                                t-if="record.ip.raw_value"
                                class="text-primary small fw-bold mb-1"
                            >
                                <i class="fa fa-plug me-1" title="IP Address" />
                                IP: <field name="ip" />
                            </div>
                            <div
                                t-if="record.last_contact_date.raw_value"
                                class="text-muted small mb-2"
                            >
                                <i class="fa fa-clock-o me-1" title="Last Contact" />
                                Last contact: <field name="last_contact_date" />
                            </div>
                            <div class="o_kanban_tags_section mt-2">
                                <field
                                    name="tag_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color'}"
                                />
                            </div>
                        </div>
                        <div
                            class="o_kanban_record_bottom d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light"
                        >
                            <div
                                class="oe_kanban_bottom_left d-flex align-items-center"
                            >
                                <field
                                    name="state"
                                    widget="label_selection"
                                    options="{'classes': {'connected': 'success', 'error': 'danger'}}"
                                />
                            </div>
                            <div
                                class="oe_kanban_bottom_right d-flex align-items-center text-truncate"
                            >
                                <span
                                    class="badge rounded-pill bg-light border text-muted px-2 py-1 me-2 shadow-sm"
                                    t-if="record.communication_system_id.raw_value"
                                >
                                    <field name="communication_system_id" />
                                </span>
                                <img
                                    t-if="record.image_128.raw_value"
                                    t-attf-src="/web/image/iot.device/#{record.id.raw_value}/image_128"
                                    class="o_avatar rounded border bg-white"
                                    style="width: 26px; height: 26px;"
                                    alt="Device"
                                />
                                <t t-else="">
                                    <i
                                        t-if="record.icon.raw_value"
                                        t-attf-class="{{record.icon.raw_value}} text-muted fs-5"
                                        title="Device Type Icon"
                                    />
                                    <i
                                        t-else=""
                                        class="fa fa-question text-muted fs-5"
                                        title="Unknown device"
                                    />
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="iot_device_search" model="ir.ui.view">
        <field name="name">iot.device.search</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <search string="IoT Device Search">
                <field name="name" />
                <field name="group_id" />
                <field name="model" />
                <field name="ip" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active','=',True)]"
                    help="Active"
                />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active','=',False)]"
                    help="Inactive"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_group"
                        string="Group"
                        domain="[]"
                        context="{'group_by':'group_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="iot_device_action">
        <field name="name">IoT Devices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">iot.device</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <menuitem
        name="Devices"
        sequence="10"
        id="iot_device_menu"
        action="iot_device_action"
        parent="iot_root_menu"
    />
</odoo>
